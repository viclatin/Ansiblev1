# API key sent by Power BI in the X-API-Key request header.
# Leave empty to disable auth (local development only).
API_KEY=

# Comma-separated list of allowed CORS origins.
# Use * to allow all origins (required for Power BI Service).
CORS_ORIGINS=*

# Absolute path to the directory containing the Power BI CSV exports.
# Defaults to <repo>/reports/powerbi — only set this if you moved the exports.
# POWERBI_DATA_DIR=/home/victor/ansible/reports/powerbi
